rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for products and categories (catalogue browsing)
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /testimonials/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default deny for sensitive admin/internal logs
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
